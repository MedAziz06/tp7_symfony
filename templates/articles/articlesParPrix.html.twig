{% extends 'base.html.twig' %}

{% block title %}Liste des Articles par Prix{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(to right, #e0f7fa, #f1f8e9);
        padding: 30px;
        font-family: 'Segoe UI', sans-serif;
    }

    .container-custom {
        background-color: #ffffffee;
        padding: 25px 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    h2 {
        margin-bottom: 25px;
        color: #00796b;
    }

    .table thead {
        background-color: #00796b;
        color: white;
    }

    .table tbody tr:hover {
        background-color: #f1f1f1;
    }

    .btn-dark {
        background-color: #455a64;
        border: none;
    }

    .btn-dark:hover {
        background-color: #263238;
    }

    .btn-danger:hover {
        background-color: #c62828;
    }
</style>

<div class="container container-custom">
    <h2>Filtrer les articles par prix</h2>

    {{ form_start(form) }}
    <div class="form-row align-items-end mb-3">
        <div class="col">
            {{ form_row(form.minPrice) }}
        </div>
        <div class="col">
            {{ form_row(form.maxPrice) }}
        </div>
        <div class="col">
            <div class="form-group">
                <button type="submit" class="btn btn-success">Rechercher</button>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

    {% if articles %}
        <table id="articles" class="table table-hover table-bordered">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Catégorie</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.nom }}</td>
                        <td>{{ article.prix }}</td>
                        <td>{{ article.category.titre }}</td>
                        <td>
                            <a href="/article/{{ article.id }}" class="btn btn-dark btn-sm">Détails</a>
                            <a href="/article/edit/{{ article.id }}" class="btn btn-secondary btn-sm">Modifier</a>
                            <a href="/article/delete/{{ article.id }}" class="btn btn-danger btn-sm"
                               onclick="return confirm('Etes-vous sûr de supprimer cet article?');">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="mt-4">Aucun article trouvé dans cette tranche de prix.</p>
    {% endif %}
</div>
{% endblock %}
