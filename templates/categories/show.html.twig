{% extends 'base.html.twig' %}

{% block title %}{{ category.titre }}{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(to right, #e0f7fa, #ede7f6);
        font-family: 'Segoe UI', sans-serif;
        padding: 40px;
    }

    .card {
        background-color: #ffffff;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        max-width: 900px;
        margin: auto;
        padding: 20px;
    }

    .card-header h1 {
        color: #6a1b9a;
        font-size: 28px;
    }

    .lead {
        font-size: 18px;
        color: #424242;
    }

    table {
        margin-top: 20px;
    }

    .table th {
        background-color: #f5f5f5;
    }

    .btn {
        margin-right: 8px;
        margin-top: 10px;
    }
</style>

<div class="card mt-4">
    <div class="card-header">
        <h1>{{ category.titre }}</h1>
    </div>
    <div class="card-body">
        {% if category.description %}
            <p class="lead">{{ category.description }}</p>
        {% endif %}

        <h3 class="mt-4">Articles dans cette catégorie ({{ category.articles|length }})</h3>

        {% if category.articles|length > 0 %}
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prix (€)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in category.articles %}
                        <tr>
                            <td>{{ article.nom }}</td>
                            <td>{{ article.prix }}</td>
                            <td>
                                <a href="{{ path('article_show', {'id': article.id}) }}" class="btn btn-sm btn-dark">Détails</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="text-muted">Aucun article dans cette catégorie.</p>
        {% endif %}

        <a href="{{ path('category_list') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('category_edit', {'id': category.id}) }}" class="btn btn-primary">Modifier</a>
        <a href="{{ path('category_delete', {'id': category.id}) }}" class="btn btn-danger"
           onclick="return confirm('Etes-vous sûr de supprimer cette catégorie?');">Supprimer</a>
    </div>
</div>
{% endblock %}
