{% extends 'base.html.twig' %}

{% block title %}Liste des Catégories{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(to right, #fce4ec, #e3f2fd);
        font-family: 'Segoe UI', sans-serif;
        padding: 40px;
    }

    .container-custom {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        max-width: 1000px;
        margin: auto;
    }

    h1 {
        color: #283593;
        text-align: center;
        margin-bottom: 30px;
    }

    .btn-primary {
        background-color: #1976d2;
        border: none;
    }

    .btn-dark {
        margin-right: 5px;
    }

    .btn-danger {
        margin-top: 5px;
    }

    table.table {
        margin-top: 20px;
        text-align: center;
    }

    .alert {
        max-width: 700px;
        margin: 10px auto;
    }
</style>

<div class="container-custom">
    <h1>Liste des Catégories</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <div class="text-end mb-3">
        <a href="{{ path('new_category') }}" class="btn btn-primary">Ajouter une catégorie</a>
    </div>

    <table id="categories" class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Nombre d'articles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
                <tr>
                    <td>{{ category.titre }}</td>
                    <td>{{ category.description|slice(0, 50) }}{% if category.description|length > 50 %}...{% endif %}</td>
                    <td>{{ category.articles|length }}</td>
                    <td>
                        <a href="{{ path('category_show', {'id': category.id}) }}" class="btn btn-dark btn-sm">Détails</a>
                        <a href="{{ path('category_edit', {'id': category.id}) }}" class="btn btn-dark btn-sm">Modifier</a>
                        <a href="{{ path('category_delete', {'id': category.id}) }}" class="btn btn-danger btn-sm"
                           onclick="return confirm('Êtes-vous sûr de supprimer cette catégorie ?');">Supprimer</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
